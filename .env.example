DATABASE_URL=sqlite:///./aerofuel.db
AEROFUEL_API_KEY=
ENVIRONMENT=local
CORS_ORIGINS=*

# Leave unset for synthetic/local mode.
FUEL_DATA_MODE=local
EXTERNAL_FUEL_API_BASE_URL=
EXTERNAL_FUEL_API_PATH_TEMPLATE=/airports/{icao}/fuel-prices
EXTERNAL_FUEL_API_KEY=
EXTERNAL_FUEL_API_KEY_HEADER=X-API-Key
EXTERNAL_FUEL_API_TIMEOUT_SECONDS=8
EXTERNAL_FUEL_ALLOWED_HOSTS=
EXTERNAL_FUEL_PROVIDER_NAME=external_fuel_provider
